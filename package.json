{
  "name": "mobile-flashcards",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "dev-client": "expo start --dev-client",
    "build:android": "eas build --profile development --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --profile production",
    "build:ios": "eas build --profile development --platform ios",
    "build:ios:production": "eas build --profile development --platform ios",
    "submit:ios": "eas submit --platform android --profile production"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "dayjs": "^1.11.11",
    "es-toolkit": "^1.40.0",
    "expo": "^58",
    "expo-checkbox": "~58.0.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
