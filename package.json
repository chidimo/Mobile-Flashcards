{
  "name": "mobile-flashcards",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "dev-client": "expo start --dev-client",
    "build:android": "eas build --profile development --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --profile production",
    "build:ios": "eas build --profile development --platform ios",
    "build:ios:production": "eas build --profile development --platform ios",
    "submit:ios": "eas submit --platform android --profile production"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "dayjs": "^1.11.11",
    "es-toolkit": "^1.40.0",
    "expo": "^54.0.13",
    "expo-checkbox": "~5.0.7",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.7",
    "expo-dev-client": "~6.0.15",
    "expo-font": "~14.0.9",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.12",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.51.5",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-notifier": "^1.9.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^18.0.7",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.12",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.9.2"
