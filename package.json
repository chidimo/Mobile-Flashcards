{
  "name": "mobile-flashcards",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "expo lint",
    "dev-client": "expo start --dev-client",
    "prebuild": "npx expo prebuild",
    "build:prod": "npx expo prebuild --clean && npx eas-cli@latest workflow:run create-production-builds.yml",
    "build:android": "eas build --profile development --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --profile production",
    "build:ios": "eas build --profile development --platform ios",
    "build:ios:production": "eas build --profile development --platform ios",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/__tests__/**/*-test.[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "utils/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "types/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/__tests__/**"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?(react-native|@react-native|@react-native-community|expo|@expo|expo-.*|@expo-google-fonts|react-navigation|@react-navigation|uuid|nativewind|react-native-css-interop)/)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.kilo/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "dayjs": "^1.11.11",
    "es-toolkit": "^1.40.0",
    "expo": "^58",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.51.5",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-notifier": "^1.9.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^18.0.7",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
