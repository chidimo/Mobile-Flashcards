{
  "cli": {
    "version": ">= 15.0.14",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.14.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "node": "22.14.0",
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.14.0",
      "channel": "production",
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "prebuildCommand": "npx expo prebuild --clean"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./mobile-flashcards-426021-58b967efd5c7.json",
        "track": "production"
      }
    }
  }
}
